        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="Entrant Storyboard, Scenario 1: search manually, win the lottery, then cancel" vertex="1">
          <mxGeometry height="40" width="1100" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;1. Main Page (Home)&lt;/b&gt;&lt;br&gt;Entrant identified by device, no login&lt;br&gt;&lt;i&gt;US 01.09.01&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="200" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;2. Search&lt;/b&gt;&lt;br&gt;Type a campsite name or area (e.g. Banff)&lt;br&gt;&lt;i&gt;US 01.01.01&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="200" x="370" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;3. Filter Campsites&lt;/b&gt;&lt;br&gt;Location, dates, number of guests&lt;br&gt;&lt;i&gt;US 01.01.02&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="200" x="690" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;4. Campsite List&lt;/b&gt;&lt;br&gt;Summaries: name, location, max occupancy, rating&lt;br&gt;&lt;i&gt;US 01.01.03, 01.01.04&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="200" x="1000" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;5. Campsite Details&lt;/b&gt;&lt;br&gt;Full details and active lottery&lt;br&gt;&lt;i&gt;US 01.01.05&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="200" x="1000" y="260" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;6. Join Waitlist&lt;/b&gt;&lt;br&gt;Join active lottery from details screen&lt;br&gt;&lt;i&gt;US 01.01.06, 01.02.01&lt;/i&gt;" vertex="1">
