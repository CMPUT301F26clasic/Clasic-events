        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-13" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom:2px solid #000;padding:6px 8px;font-size:18px;&quot;&gt;&lt;b&gt;Image&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:280px;border-right:2px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Stores uploaded image&lt;br&gt;- Knows uploader and what it belongs to (campsite or profile)&lt;br&gt;- Can be removed&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;User&lt;br&gt;Campsite&lt;br&gt;DatabaseController&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
