        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-7" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;SearchFilter&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Stores keyword, location, dates, and number of guests&lt;br&gt;- Checks if a campsite matches&lt;br&gt;- Returns list of matching campsites&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Campsite&lt;br&gt;Availability&lt;br&gt;DatabaseController&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="117" width="460" x="10" y="362" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-8" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;Lottery&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Knows campsite(s) included&lt;br&gt;- Stores registration and booking period&lt;br&gt;- Stores number of winners&lt;br&gt;- Knows whether it is active&lt;br&gt;- Draws winners when registration ends&lt;br&gt;- Notifies winners and losers&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Campsite&lt;br&gt;WaitingList&lt;br&gt;Entrant&lt;br&gt;CampsiteOwner&lt;br&gt;Notification&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="150" width="430" x="1010" y="419" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-9" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom:2px solid #000;padding:6px 8px;font-size:18px;&quot;&gt;&lt;b&gt;WaitingList&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:280px;border-right:2px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Stores entrants who joined&lt;br&gt;- Adds and removes entrants&lt;br&gt;- Enforces optional capacity&lt;br&gt;- Prevents duplicate joins&lt;br&gt;- Provides entrants for the draw and owner view&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Lottery&lt;br&gt;Entrant&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="146" width="460" x="510" y="433" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-10" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;Reservation&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Stores entrant, campsite, and dates&lt;br&gt;- Tracks status: active, past, cancelled, and rejected&lt;br&gt;- Records that rules were accepted&lt;br&gt;- Confirms, cancels, or rejects&lt;br&gt;- Exports confirmation as CSV&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Entrant&lt;br&gt;Campsite&lt;br&gt;Availability&lt;br&gt;Notification&lt;br&gt;DatabaseController&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="140" width="490" x="10" y="509" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-11" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;Notification&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Stores sender, recipient, type, message, and time&lt;br&gt;- Sends win, lose, confirmation, cancellation and owner messages&lt;br&gt;- Respects user opt-out&lt;br&gt;- Kept as a log for owner and admin&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;User&lt;br&gt;Lottery&lt;br&gt;Reservation&lt;br&gt;CampsiteOwner&lt;br&gt;DatabaseController&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
