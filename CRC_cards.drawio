  <diagram id="rLgPAER3ayMoLgAIy9C8" name="CRC Cards">
    <mxGraphModel dx="1713" dy="944" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-1" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Identified by device ID (no login)&lt;br&gt;- Stores name, email, phone, and profile image&lt;br&gt;- Updates or deletes own profile&lt;br&gt;- Stores notification opt-out setting&lt;br&gt;- Holds roles: entrant, owner, admin&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Image&lt;br&gt;DatabaseController&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="146" width="460" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-2" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom:2px solid #000;padding:6px 8px;font-size:18px;&quot;&gt;&lt;b&gt;Entrant&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:280px;border-right:2px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Searches and filters campsites&lt;br&gt;- Views campsite summary and details&lt;br&gt;- Scans QR code to open a listing&lt;br&gt;- Joins or leaves lottery waiting lists&lt;br&gt;- Accepts or declines a lottery win&lt;br&gt;- Chooses campsite and dates to reserve&lt;br&gt;- Confirms rules before reserving&lt;br&gt;- Cancels a reservation&lt;br&gt;- Views active and past reservations&lt;br&gt;- Rates campsites&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;User&lt;br&gt;SearchFilter&lt;br&gt;Campsite&lt;br&gt;QRCode&lt;br&gt;WaitingList&lt;br&gt;Lottery&lt;br&gt;Reservation&lt;br&gt;Notification&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="200" width="460" x="510" y="10" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-3" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;CampsiteOwner&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Registers campsites&lt;br&gt;- Views and updates campsite details&lt;br&gt;- Views list of own campsites&lt;br&gt;- Creates and updates lotteries&lt;br&gt;- Views entrants on a waiting list&lt;br&gt;- Views booked dates&lt;br&gt;- Views active, past, and cancelled reservations&lt;br&gt;- Rejects reservations&lt;br&gt;- Sends notifications and messages to entrants&lt;br&gt;- Views notifications sent&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;User&lt;br&gt;Campsite&lt;br&gt;Availability&lt;br&gt;Lottery&lt;br&gt;WaitingList&lt;br&gt;Reservation&lt;br&gt;Notification&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="233" width="460" x="1010" y="10" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-4" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;Admin&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Browses and removes campsites,&amp;nbsp;profiles, and images&lt;br&gt;- Removes owners who violate policy&lt;br&gt;- Reviews notification and message logs&lt;br&gt;- Can also act as entrant or owner&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;User&lt;br&gt;CampsiteOwner&lt;br&gt;Campsite&lt;br&gt;Image&lt;br&gt;Notification&lt;br&gt;DatabaseController&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="146" width="460" x="10" y="186" as="geometry" />
        </mxCell>
        <mxCell id="Qu6ItcFTNHLKm9xo5_g_-5" parent="1" style="text;html=1;whiteSpace=wrap;autosize=1;overflow=fill;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Verdana;fontSize=12;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:Verdana;font-size:12px;line-height:1.2;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border-bottom: 2px solid rgb(0, 0, 0); padding: 6px 8px; font-size: 18px;&quot;&gt;&lt;b&gt;Campsite&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width: 280px; border-right: 2px solid rgb(0, 0, 0); padding: 4px 8px; vertical-align: top;&quot;&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;- Stores name, description, amenities, tags, location and map coordinates, max occupancy, price, rules, and cancellation policy&lt;br&gt;- Calculates average rating&lt;br&gt;- Knows its owner and promo image&lt;br&gt;- Provides summary and details&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;CampsiteOwner&lt;br&gt;Availability&lt;br&gt;Image&lt;br&gt;QRCode&lt;br&gt;Lottery&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="160" width="460" x="510" y="243" as="geometry" />
